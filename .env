# API Configuration
VITE_API_URL=https://api.sappey.com/api

# Guest Checkout - Contact type for OTP verification
# Options: email, phone, whatsapp  
# This should match the NOTIFICATION_CHANNEL set in backend .env
# The backend will determine which contact method to use based on NOTIFICATION_CHANNEL
# email -> Email address required for OTP
# phone -> Phone number required for OTP (via SMS)
# whatsapp -> WhatsApp number required for OTP
